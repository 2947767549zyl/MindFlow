# backend service base url, test environment
VITE_SERVICE_BASE_URL=http://localhost:8081/api/v1

# enable vite dev-server http proxy to avoid browser cross-origin (CORS preflight)
# only takes effect in DEV mode (import.meta.env.DEV), production build is unaffected
VITE_HTTP_PROXY=Y
# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "api": "http://localhost:8081/api/v1",
  "ws": "ws://localhost:8081"
}`
